# Contraseña compartida para entrar al panel de administración (/admin/*).
# Elegí una contraseña larga y única; no la reutilices de otro servicio.
ADMIN_PASSWORD=

# Secreto usado para firmar (HMAC-SHA256) la cookie de sesión del panel de admin.
# Generalo con algo random y largo, por ejemplo: openssl rand -base64 32
ADMIN_SESSION_SECRET=
