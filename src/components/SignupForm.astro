---
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section class="signup-form">
  <h2>Inscribite</h2>
  <p>Dejanos tus datos y te contamos las novedades del evento.</p>
  <form data-signup-form>
    <label class="signup-form__field">
      Nombre
      <input type="text" name="name" placeholder="Ej: Juan Pérez" required maxlength="100" />
    </label>
    <label class="signup-form__field">
      Email
      <input type="email" name="email" placeholder="Ej: juan@email.com" required />
    </label>
    <label class="signup-form__field">
      Celular
      <input type="tel" name="phone" placeholder="Ej: 11 2345 6789" required pattern="[0-9+\s()-]{7,20}" />
    </label>
    {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
    <button type="submit">Enviar</button>
  </form>
  <p data-signup-message role="status"></p>
</section>

<style>
  .signup-form {
    max-width: 500px;
    margin: var(--spacing-lg) auto;
    padding: var(--spacing-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-align: center;
  }
  .signup-form h2 {
    color: var(--color-primary-dark);
    margin-bottom: 0.25rem;
  }
  .signup-form p {
    color: var(--color-text-muted);
  }
  .signup-form p[data-state='success'] {
    color: #2f7a3d;
  }
  .signup-form p[data-state='error'] {
    color: #b3261e;
  }
  .signup-form form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    margin-top: var(--spacing-sm);
  }
  .signup-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: left;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .signup-form input {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font: inherit;
  }
  .signup-form button {
    padding: 0.75rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: var(--radius);
    font-weight: 700;
    cursor: pointer;
  }
  .signup-form button:hover {
    background: var(--color-primary-dark);
  }
</style>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-signup-form]');
  const message = document.querySelector<HTMLElement>('[data-signup-message]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !message) return;
    const formData = new FormData(form);
    const payload = {
      name: formData.get('name'),
      email: formData.get('email'),
      phone: formData.get('phone'),
      turnstileToken: formData.get('cf-turnstile-response'),
    };

    const response = await fetch('/api/signup', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (response.ok) {
      message.textContent = '¡Gracias! Ya te anotamos.';
      message.dataset.state = 'success';
      form.reset();
    } else {
      const body = await response.json().catch(() => null);
      message.textContent =
        response.status === 400
          ? 'Revisá que el nombre, el email y el celular tengan un formato válido.'
          : (body?.error ?? 'Hubo un error, probá de nuevo.');
      message.dataset.state = 'error';
    }
  });
</script>
