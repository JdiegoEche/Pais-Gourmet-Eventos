---
import { thumb } from '../lib/image';

interface Props {
  photos: string[];
  alt: string;
}

const { photos, alt } = Astro.props;
---

<div class="photo-gallery" data-photo-gallery>
  <div class="photo-gallery__viewport">
    <div class="photo-gallery__strip" data-photo-strip>
      {photos.map((src, index) => (
        <button
          type="button"
          class="photo-gallery__frame"
          data-photo-trigger
          data-src={src}
          data-index={index}
          aria-label={`Ver foto ${index + 1} de ${alt} en pantalla completa`}
        >
          <img src={thumb(src, 1000)} alt={`${alt} — foto ${index + 1}`} loading={index === 0 ? 'eager' : 'lazy'} />
        </button>
      ))}
    </div>
    {photos.length > 1 && (
      <>
        <button type="button" class="photo-gallery__nav photo-gallery__nav--prev" data-strip-prev aria-label="Fotos anteriores">‹</button>
        <button type="button" class="photo-gallery__nav photo-gallery__nav--next" data-strip-next aria-label="Fotos siguientes">›</button>
      </>
    )}
  </div>

  {photos.length > 1 && <div class="photo-gallery__dots" data-photo-dots></div>}
</div>

<dialog class="photo-gallery__dialog" data-photo-dialog>
  <button type="button" class="photo-gallery__close" data-photo-close aria-label="Cerrar">✕</button>
  {photos.length > 1 && (
    <>
      <button type="button" class="photo-gallery__nav photo-gallery__nav--prev" data-photo-prev aria-label="Foto anterior">‹</button>
      <button type="button" class="photo-gallery__nav photo-gallery__nav--next" data-photo-next aria-label="Foto siguiente">›</button>
    </>
  )}
  <img data-photo-dialog-image alt="" />
</dialog>

<style>
  .photo-gallery {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  .photo-gallery__viewport {
    position: relative;
  }
  .photo-gallery__strip {
    display: flex;
    gap: var(--spacing-sm);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .photo-gallery__strip::-webkit-scrollbar {
    display: none;
  }
  .photo-gallery__frame {
    flex: 0 0 auto;
    height: 420px;
    padding: 0;
    border: none;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    scroll-snap-align: start;
    background: var(--color-surface);
  }
  .photo-gallery__frame img {
    display: block;
    height: 100%;
    width: auto;
  }
  @media (max-width: 720px) {
    .photo-gallery__frame {
      height: 240px;
    }
  }
  .photo-gallery__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  /* Los dots se crean con document.createElement en runtime, así que no reciben
     el atributo de scope de Astro — deben quedar como reglas globales. */
  :global(.photo-gallery__dot) {
    width: 0.6rem;
    height: 0.6rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--color-border);
    cursor: pointer;
  }
  :global(.photo-gallery__dot[aria-current='true']) {
    background: var(--color-primary);
  }
  .photo-gallery__dialog {
    position: relative;
    border: none;
    border-radius: var(--radius);
    padding: 0;
    max-width: min(90vw, 900px);
    max-height: 90vh;
    background: transparent;
  }
  .photo-gallery__dialog::backdrop {
    background: rgba(20, 14, 8, 0.75);
  }
  .photo-gallery__dialog img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .photo-gallery__close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: var(--color-surface);
    border: none;
    border-radius: 50%;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
  }
  .photo-gallery__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: var(--color-surface);
    border: none;
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.5rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .photo-gallery__nav:hover {
    background: var(--color-accent);
  }
  .photo-gallery__nav--prev {
    left: 0.5rem;
  }
  .photo-gallery__nav--next {
    right: 0.5rem;
  }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-photo-gallery]');
  const strip = gallery?.querySelector<HTMLElement>('[data-photo-strip]');
  const dotsContainer = gallery?.querySelector<HTMLElement>('[data-photo-dots]');
  const stripPrev = gallery?.querySelector<HTMLButtonElement>('[data-strip-prev]');
  const stripNext = gallery?.querySelector<HTMLButtonElement>('[data-strip-next]');

  function updateActiveDot() {
    if (!strip || !dotsContainer || strip.clientWidth === 0) return;
    const dots = Array.from(dotsContainer.children);
    const index = Math.round(strip.scrollLeft / strip.clientWidth);
    dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
  }

  function buildDots() {
    if (!strip || !dotsContainer || strip.clientWidth === 0) return;
    const segments = Math.max(1, Math.round(strip.scrollWidth / strip.clientWidth));
    dotsContainer.innerHTML = '';
    for (let i = 0; i < segments; i++) {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'photo-gallery__dot';
      dot.setAttribute('aria-label', `Ir a la sección ${i + 1} de fotos`);
      dot.addEventListener('click', () => {
        strip.scrollTo({ left: i * strip.clientWidth, behavior: 'smooth' });
      });
      dotsContainer.appendChild(dot);
    }
    updateActiveDot();
  }

  strip?.addEventListener('scroll', () => window.requestAnimationFrame(updateActiveDot));
  window.addEventListener('resize', buildDots);
  strip?.querySelectorAll('img').forEach((img) => img.addEventListener('load', buildDots));
  buildDots();

  stripPrev?.addEventListener('click', () => strip?.scrollBy({ left: -(strip.clientWidth), behavior: 'smooth' }));
  stripNext?.addEventListener('click', () => strip?.scrollBy({ left: strip.clientWidth, behavior: 'smooth' }));

  gallery?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') strip?.scrollBy({ left: -(strip.clientWidth), behavior: 'smooth' });
    if (event.key === 'ArrowRight') strip?.scrollBy({ left: strip.clientWidth, behavior: 'smooth' });
  });

  const dialog = document.querySelector<HTMLDialogElement>('[data-photo-dialog]');
  const dialogImage = dialog?.querySelector<HTMLImageElement>('[data-photo-dialog-image]');
  const prevButton = dialog?.querySelector<HTMLButtonElement>('[data-photo-prev]');
  const nextButton = dialog?.querySelector<HTMLButtonElement>('[data-photo-next]');
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-photo-trigger]'));

  let currentIndex = 0;

  function showPhoto(index: number) {
    if (!dialogImage || triggers.length === 0) return;
    currentIndex = (index + triggers.length) % triggers.length;
    dialogImage.src = triggers[currentIndex].dataset.src ?? '';
  }

  triggers.forEach((trigger, index) => {
    trigger.addEventListener('click', () => {
      if (!dialog) return;
      showPhoto(index);
      dialog.showModal();
    });
  });

  prevButton?.addEventListener('click', () => showPhoto(currentIndex - 1));
  nextButton?.addEventListener('click', () => showPhoto(currentIndex + 1));

  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') showPhoto(currentIndex - 1);
    if (event.key === 'ArrowRight') showPhoto(currentIndex + 1);
  });

  document.querySelector('[data-photo-close]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
