---
import { thumb, thumbSrcSet } from '../lib/image';

interface Props {
  photos: string[];
  alt: string;
}

const { photos, alt } = Astro.props;
---

<div class="photo-gallery" data-photo-gallery>
  <div class="photo-gallery__viewport">
    <div class="photo-gallery__strip" data-photo-strip>
      {photos.map((src, index) => (
        <button
          type="button"
          class="photo-gallery__frame"
          data-photo-trigger
          data-src={src}
          data-index={index}
          data-alt={`${alt} — foto ${index + 1}`}
          aria-label={`Ver foto ${index + 1} de ${alt} en pantalla completa`}
        >
          <img
            src={thumb(src, 1000)}
            srcset={thumbSrcSet(src, [480, 800, 1200])}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 92vw"
            alt={`${alt} — foto ${index + 1}`}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </button>
      ))}
    </div>
    {photos.length > 1 && (
      <>
        <button type="button" class="photo-gallery__nav photo-gallery__nav--prev" data-strip-prev aria-label="Fotos anteriores">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="photo-gallery__nav photo-gallery__nav--next" data-strip-next aria-label="Fotos siguientes">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </>
    )}
  </div>

  {photos.length > 1 && <div class="photo-gallery__dots" data-photo-dots></div>}
</div>

<dialog class="photo-gallery__dialog" data-photo-dialog>
  <button type="button" class="photo-gallery__close" data-photo-close aria-label="Cerrar">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  {photos.length > 1 && (
    <>
      <button type="button" class="photo-gallery__nav photo-gallery__nav--prev" data-photo-prev aria-label="Foto anterior">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button type="button" class="photo-gallery__nav photo-gallery__nav--next" data-photo-next aria-label="Foto siguiente">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </>
  )}
  <img data-photo-dialog-image alt="" decoding="async" />
</dialog>

<style>
  .photo-gallery {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  .photo-gallery__viewport {
    position: relative;
  }
  .photo-gallery__strip {
    display: flex;
    gap: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .photo-gallery__strip::-webkit-scrollbar {
    display: none;
  }
  .photo-gallery__frame {
    flex: 0 0 92%;
    aspect-ratio: 1 / 1;
    padding: 0;
    border: none;
    overflow: hidden;
    cursor: pointer;
    scroll-snap-align: start;
    background: var(--color-surface);
  }
  .photo-gallery__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 640px) {
    .photo-gallery__frame {
      flex-basis: 50%;
    }
  }
  @media (min-width: 1024px) {
    .photo-gallery__frame {
      flex-basis: calc(100% / 3);
    }
  }
  .photo-gallery__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding: 0 var(--spacing-md);
  }
  /* Los dots se crean con document.createElement en runtime, así que no reciben
     el atributo de scope de Astro — deben quedar como reglas globales. */
  :global(.photo-gallery__dot) {
    width: 0.6rem;
    height: 0.6rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--color-border);
    cursor: pointer;
  }
  :global(.photo-gallery__dot[aria-current='true']) {
    background: var(--color-primary);
  }
  .photo-gallery__dialog {
    position: relative;
    border: none;
    border-radius: var(--radius);
    padding: 0;
    max-width: min(90vw, 900px);
    max-height: 90vh;
    background: transparent;
  }
  /* "display" solo se fija cuando está abierto: si se pisa el "display: none" nativo del
     <dialog> cerrado (dialog:not([open])), queda renderizado en el flujo normal de la
     página aunque esté cerrado. */
  .photo-gallery__dialog[open] {
    display: flex;
  }
  .photo-gallery__dialog::backdrop {
    background: rgba(20, 14, 8, 0.75);
  }
  .photo-gallery__dialog img {
    display: block;
    /* Ancho/alto en "auto" + estos topes (en vez de 100%/100% del dialog, que no tiene un
       tamaño propio) es lo que deja que la imagen se achique proporcionalmente en vez de
       mostrarse a su resolución nativa y forzar scroll. */
    width: auto;
    height: auto;
    max-width: min(90vw, 900px);
    max-height: 90vh;
    object-fit: contain;
  }
  .photo-gallery__close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: var(--color-surface);
    border: none;
    border-radius: 50%;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .photo-gallery__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: var(--color-surface);
    border: none;
    border-radius: 50%;
    width: 2.75rem;
    height: 2.75rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .photo-gallery__nav:hover {
    background: var(--color-accent);
  }
  .photo-gallery__nav--prev {
    left: 0.5rem;
  }
  .photo-gallery__nav--next {
    right: 0.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-gallery__strip {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-photo-gallery]');
  const strip = gallery?.querySelector<HTMLElement>('[data-photo-strip]');
  const dotsContainer = gallery?.querySelector<HTMLElement>('[data-photo-dots]');
  const stripPrev = gallery?.querySelector<HTMLButtonElement>('[data-strip-prev]');
  const stripNext = gallery?.querySelector<HTMLButtonElement>('[data-strip-next]');
  const scrollBehavior: ScrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ? 'auto'
    : 'smooth';

  function updateActiveDot() {
    if (!strip || !dotsContainer || strip.clientWidth === 0) return;
    const dots = Array.from(dotsContainer.children);
    const index = Math.round(strip.scrollLeft / strip.clientWidth);
    dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
  }

  function buildDots() {
    if (!strip || !dotsContainer || strip.clientWidth === 0) return;
    const segments = Math.max(1, Math.round(strip.scrollWidth / strip.clientWidth));
    dotsContainer.innerHTML = '';
    for (let i = 0; i < segments; i++) {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'photo-gallery__dot';
      dot.setAttribute('aria-label', `Ir a la sección ${i + 1} de fotos`);
      dot.addEventListener('click', () => {
        strip.scrollTo({ left: i * strip.clientWidth, behavior: scrollBehavior });
      });
      dotsContainer.appendChild(dot);
    }
    updateActiveDot();
  }

  strip?.addEventListener('scroll', () => window.requestAnimationFrame(updateActiveDot));
  window.addEventListener('resize', buildDots);
  strip?.querySelectorAll('img').forEach((img) => img.addEventListener('load', buildDots));
  buildDots();

  function scrollToNextSegment() {
    if (!strip) return;
    const maxScrollLeft = strip.scrollWidth - strip.clientWidth;
    // -1 por redondeo de subpíxel: en algunos navegadores scrollLeft nunca llega exacto al máximo.
    const atEnd = strip.scrollLeft >= maxScrollLeft - 1;
    strip.scrollTo({ left: atEnd ? 0 : strip.scrollLeft + strip.clientWidth, behavior: scrollBehavior });
  }

  stripPrev?.addEventListener('click', () => strip?.scrollBy({ left: -(strip.clientWidth), behavior: scrollBehavior }));
  stripNext?.addEventListener('click', scrollToNextSegment);

  gallery?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') strip?.scrollBy({ left: -(strip.clientWidth), behavior: scrollBehavior });
    if (event.key === 'ArrowRight') scrollToNextSegment();
  });

  const dialog = document.querySelector<HTMLDialogElement>('[data-photo-dialog]');
  const dialogImage = dialog?.querySelector<HTMLImageElement>('[data-photo-dialog-image]');
  const prevButton = dialog?.querySelector<HTMLButtonElement>('[data-photo-prev]');
  const nextButton = dialog?.querySelector<HTMLButtonElement>('[data-photo-next]');
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-photo-trigger]'));

  let currentIndex = 0;

  function showPhoto(index: number) {
    if (!dialogImage || triggers.length === 0) return;
    currentIndex = (index + triggers.length) % triggers.length;
    dialogImage.src = triggers[currentIndex].dataset.src ?? '';
    dialogImage.alt = triggers[currentIndex].dataset.alt ?? '';
  }

  triggers.forEach((trigger, index) => {
    trigger.addEventListener('click', () => {
      if (!dialog) return;
      showPhoto(index);
      dialog.showModal();
    });
  });

  prevButton?.addEventListener('click', () => showPhoto(currentIndex - 1));
  nextButton?.addEventListener('click', () => showPhoto(currentIndex + 1));

  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') showPhoto(currentIndex - 1);
    if (event.key === 'ArrowRight') showPhoto(currentIndex + 1);
  });

  document.querySelector('[data-photo-close]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
