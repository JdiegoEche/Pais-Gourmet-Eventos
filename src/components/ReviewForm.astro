---
import StarRating from './StarRating.astro';

interface Props {
  restaurantSlug: string;
}

const { restaurantSlug } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form class="review-form" data-review-form data-restaurant-slug={restaurantSlug}>
  <h3>Dejá tu reseña</h3>
  <div class="review-form__ratings">
    <StarRating name="foodRating" label="Comida" />
    <StarRating name="serviceRating" label="Servicio" />
    <StarRating name="ambianceRating" label="Ambiente" />
  </div>
  <label class="review-form__field">
    <strong>Nombre <span class="required-marker" aria-hidden="true">*</span></strong>
    <input type="text" name="name" placeholder="Ej: Juan Pérez" required minlength="3" maxlength="30" />
  </label>
  <label class="review-form__field">
    <strong>Celular <span class="required-marker" aria-hidden="true">*</span></strong>
    <input type="tel" name="phone" placeholder="Ej: 11 2345 6789" required pattern="[0-9+\s()-]{7,20}" />
  </label>
  <label class="review-form__field">
    <strong>Email <span class="required-marker" aria-hidden="true">*</span></strong>
    <input type="email" name="email" placeholder="Ej: juan@email.com" required />
  </label>
  <p class="review-form__privacy">Tu celular y email no se publican.</p>
  <label class="review-form__field">
    <strong>Comentario <span class="required-marker" aria-hidden="true">*</span></strong>
    <textarea name="comment" placeholder="Contanos cómo fue tu experiencia" required maxlength="300"></textarea>
  </label>
  {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
  <button type="submit">Publicar reseña</button>
  <p class="review-form__status" data-review-status role="status"></p>
</form>

<style>
  .review-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    max-width: 480px;
    padding: var(--spacing-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .review-form h3 {
    margin: 0 0 0.25rem;
    color: var(--color-text);
  }
  .review-form__privacy {
    margin: -0.25rem 0 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .review-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9rem;
    color: var(--color-text);
  }
  .review-form input,
  .review-form textarea {
    padding: 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) / 2);
    font: inherit;
  }
  .review-form__ratings {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xs);
  }
  .review-form textarea {
    min-height: 6rem;
    resize: vertical;
  }
  .review-form button[type='submit'] {
    align-self: flex-start;
    padding: 0.6rem 1.5rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: var(--radius);
    font-weight: 600;
    cursor: pointer;
  }
  .review-form button[type='submit']:hover {
    background: var(--color-primary-dark);
  }
  .review-form__status {
    margin: 0;
    font-size: 0.9rem;
    min-height: 1.2em;
  }
  .review-form__status[data-state='success'] {
    color: #2f7a3d;
  }
  .review-form__status[data-state='error'] {
    color: #b3261e;
  }
  .required-marker {
    color: #b3261e;
  }
</style>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-review-form]');
  const status = form?.querySelector<HTMLParagraphElement>('[data-review-status]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const restaurantSlug = form.dataset.restaurantSlug;
    const formData = new FormData(form);

    try {
      const response = await fetch('/api/reviews', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          restaurantSlug,
          name: formData.get('name'),
          phone: formData.get('phone'),
          email: formData.get('email'),
          foodRating: Number(formData.get('foodRating')),
          serviceRating: Number(formData.get('serviceRating')),
          ambianceRating: Number(formData.get('ambianceRating')),
          comment: formData.get('comment'),
          turnstileToken: formData.get('cf-turnstile-response'),
        }),
      });

      if (!response.ok) {
        const body = await response.json().catch(() => null);
        if (status) {
          status.textContent =
            response.status === 400
              ? 'Revisá el nombre, el celular, el email y el comentario: alguno tiene un formato inválido.'
              : (body?.error ?? 'No pudimos publicar tu reseña. Intentá de nuevo.');
          status.dataset.state = 'error';
        }
        return;
      }

      form.reset();
      if (status) {
        status.textContent = '¡Gracias por tu reseña!';
        status.dataset.state = 'success';
      }
      document.dispatchEvent(new CustomEvent('review:created', { detail: { restaurantSlug } }));
    } catch {
      if (status) {
        status.textContent = 'No pudimos publicar tu reseña. Revisá tu conexión e intentá de nuevo.';
        status.dataset.state = 'error';
      }
    }
  });
</script>
