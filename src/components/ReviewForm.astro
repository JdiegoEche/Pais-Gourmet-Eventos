---
import StarRating from './StarRating.astro';

interface Props {
  restaurantSlug: string;
}

const { restaurantSlug } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form class="review-form" data-review-form data-restaurant-slug={restaurantSlug}>
  <h3>Dejá tu reseña</h3>
  <div class="review-form__ratings">
    <StarRating name="foodRating" label="Comida" />
    <StarRating name="serviceRating" label="Servicio" />
    <StarRating name="ambianceRating" label="Ambiente" />
  </div>
  <label class="review-form__field">
    <strong>Nombre <span class="required-marker" aria-hidden="true">*</span></strong>
    <input type="text" name="name" placeholder="Ej: Juan Pérez" required minlength="3" maxlength="30" />
  </label>
  <label class="review-form__field">
    <strong>Celular <span class="required-marker" aria-hidden="true">*</span></strong>
    <input type="tel" name="phone" placeholder="Ej: 11 2345 6789" required pattern="[0-9+\s()-]{7,20}" />
  </label>
  <label class="review-form__field">
    <strong>Email <span class="required-marker" aria-hidden="true">*</span></strong>
    <input type="email" name="email" placeholder="Ej: juan@email.com" required />
  </label>
  <p class="review-form__privacy">Tu celular y email no se publican.</p>
  <label class="review-form__field">
    <strong>Comentario <span class="required-marker" aria-hidden="true">*</span></strong>
    <textarea name="comment" placeholder="Contanos cómo fue tu experiencia" required maxlength="300"></textarea>
  </label>
  {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
  <button type="submit" data-submit-button>Publicar reseña</button>
  <p class="review-form__status" data-review-status role="status"></p>
</form>

<style>
  .review-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    max-width: 480px;
    padding: var(--spacing-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .review-form h3 {
    margin: 0 0 0.25rem;
    color: var(--color-text);
  }
  .review-form__privacy {
    margin: -0.25rem 0 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .review-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9rem;
    color: var(--color-text);
  }
  .review-form input,
  .review-form textarea {
    padding: 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) / 2);
    font: inherit;
  }
  .review-form__ratings {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xs);
  }
  .review-form textarea {
    min-height: 6rem;
    resize: vertical;
  }
  .review-form button[type='submit'] {
    position: relative;
    align-self: flex-start;
    padding: 0.6rem 1.5rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: var(--radius);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }
  .review-form button[type='submit']:hover:not(:disabled) {
    background: var(--color-primary-dark);
  }
  .review-form button[type='submit']:active:not(:disabled) {
    transform: scale(0.97);
  }
  .review-form button[type='submit']:disabled {
    cursor: default;
  }
  .review-form button[type='submit'][data-loading='true'] {
    padding-left: 2.35rem;
    opacity: 0.85;
  }
  .review-form button[type='submit'][data-loading='true']::before {
    content: '';
    position: absolute;
    left: 0.85rem;
    top: 50%;
    width: 0.9rem;
    height: 0.9rem;
    margin-top: -0.45rem;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top-color: #fff;
    border-radius: 50%;
    animation: review-form-spin 0.6s linear infinite;
  }
  .review-form button[type='submit'].is-success {
    background: #2f7a3d;
  }
  .review-form__status {
    margin: 0;
    font-size: 0.9rem;
    min-height: 1.2em;
  }
  .review-form__status[data-state='success'] {
    color: #2f7a3d;
  }
  .review-form__status[data-state='error'] {
    color: #b3261e;
  }
  .review-form__status--animate {
    animation: review-form-status-pop 0.35s ease;
  }
  .required-marker {
    color: #b3261e;
  }
  @keyframes review-form-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes review-form-status-pop {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .review-form button[type='submit'][data-loading='true']::before {
      animation: none;
    }
    .review-form__status--animate {
      animation: none;
    }
  }
</style>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  import { withLoading } from '../lib/withLoading';

  const form = document.querySelector<HTMLFormElement>('[data-review-form]');
  const status = form?.querySelector<HTMLParagraphElement>('[data-review-status]');
  const submitButton = form?.querySelector<HTMLButtonElement>('[data-submit-button]');
  const defaultButtonText = submitButton?.textContent ?? 'Publicar reseña';
  let successTimeout: ReturnType<typeof setTimeout> | undefined;

  // Retriggerea la animación de "pop" aunque el mensaje ya tuviera la clase de una reseña
  // anterior: sin sacarla y forzar un reflow antes de volver a agregarla, el navegador no
  // vuelve a correr la misma animación CSS.
  function animateStatus() {
    if (!status) return;
    status.classList.remove('review-form__status--animate');
    void status.offsetWidth;
    status.classList.add('review-form__status--animate');
  }

  // El disabled/texto-original ya los restaura withLoading en su "finally" — esto solo agrega
  // el flash verde encima, específico de este formulario.
  function showSuccessPulse() {
    if (!submitButton) return;
    clearTimeout(successTimeout);
    submitButton.classList.add('is-success');
    submitButton.textContent = '¡Publicada! ✓';
    successTimeout = setTimeout(() => {
      submitButton.classList.remove('is-success');
      submitButton.textContent = defaultButtonText;
    }, 1400);
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!submitButton) return;
    const restaurantSlug = form.dataset.restaurantSlug;
    const formData = new FormData(form);

    try {
      const succeeded = await withLoading(submitButton, 'Publicando…', async () => {
        const response = await fetch('/api/reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            restaurantSlug,
            name: formData.get('name'),
            phone: formData.get('phone'),
            email: formData.get('email'),
            foodRating: Number(formData.get('foodRating')),
            serviceRating: Number(formData.get('serviceRating')),
            ambianceRating: Number(formData.get('ambianceRating')),
            comment: formData.get('comment'),
            turnstileToken: formData.get('cf-turnstile-response'),
          }),
        });

        if (!response.ok) {
          const body = await response.json().catch(() => null);
          if (status) {
            status.textContent =
              response.status === 400
                ? 'Revisá el nombre, el celular, el email y el comentario: alguno tiene un formato inválido.'
                : (body?.error ?? 'No pudimos publicar tu reseña. Intentá de nuevo.');
            status.dataset.state = 'error';
            animateStatus();
          }
          return false;
        }

        form.reset();
        if (status) {
          status.textContent = '¡Gracias por tu reseña!';
          status.dataset.state = 'success';
          animateStatus();
        }
        document.dispatchEvent(new CustomEvent('review:created', { detail: { restaurantSlug } }));
        return true;
      });

      if (succeeded) showSuccessPulse();
    } catch {
      if (status) {
        status.textContent = 'No pudimos publicar tu reseña. Revisá tu conexión e intentá de nuevo.';
        status.dataset.state = 'error';
        animateStatus();
      }
    }
  });
</script>
