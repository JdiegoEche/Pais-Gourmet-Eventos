---
import { thumb, thumbSrcSet } from '../lib/image';

interface Props {
  imageUrl: string;
}

const { imageUrl } = Astro.props;
---

{imageUrl && (
  <section class="what-includes">
    <h2>¿Qué incluye?</h2>
    <img
      src={thumb(imageUrl, 900)}
      srcset={thumbSrcSet(imageUrl, [600, 900])}
      sizes="(max-width: 900px) 100vw, 900px"
      alt="Qué incluye el menú"
      loading="lazy"
    />
  </section>
)}

<style>
  .what-includes {
    padding: var(--spacing-lg) var(--spacing-md);
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }
  .what-includes h2 {
    color: var(--color-primary-dark);
    margin-bottom: var(--spacing-md);
  }
  .what-includes img {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
</style>
