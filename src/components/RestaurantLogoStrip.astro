---
import type { Restaurant } from '../types';
import { thumb } from '../lib/image';

interface Props {
  restaurants: Restaurant[];
}

const { restaurants } = Astro.props;
---

{restaurants.length > 0 && (
  <section class="logo-strip">
    <h2>Conocé algunos de los restaurantes</h2>
    <div class="logo-strip__track">
      {restaurants.map((restaurant) => (
        <a class="logo-strip__item" href={`/restaurante/${restaurant.slug}`} aria-label={restaurant.name}>
          <img src={thumb(restaurant.logo ?? restaurant.gallery[0], 160)} alt={restaurant.name} loading="lazy" />
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .logo-strip {
    padding: var(--spacing-lg) var(--spacing-md);
    max-width: 1100px;
    margin: 0 auto;
  }
  .logo-strip h2 {
    color: var(--color-primary-dark);
    text-align: center;
    margin-bottom: var(--spacing-md);
  }
  .logo-strip__track {
    display: flex;
    gap: var(--spacing-md);
    overflow-x: auto;
    padding-bottom: var(--spacing-xs);
  }
  .logo-strip__item {
    flex: 0 0 auto;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .logo-strip__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
