---
import type { EventData } from '../types';

interface Props {
  event: EventData;
}

const { event } = Astro.props;
---

<section class="event-hero">
  <h1>{event.name}</h1>
  <p class="event-hero__dates">{event.startDate} — {event.endDate}</p>
  <p class="event-hero__description">{event.whatIncludes}</p>
  <a class="event-hero__cta" href="/restaurantes-participantes">Ver restaurantes participantes</a>
</section>

<style>
  .event-hero {
    padding: var(--spacing-xl) var(--spacing-md);
    text-align: center;
    background: linear-gradient(180deg, var(--color-surface), var(--color-bg));
    border-bottom: 1px solid var(--color-border);
  }
  .event-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-primary-dark);
    margin: 0 0 var(--spacing-xs);
  }
  .event-hero__dates {
    color: var(--color-text-muted);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 var(--spacing-sm);
  }
  .event-hero__description {
    max-width: 640px;
    margin: 0 auto var(--spacing-md);
    color: var(--color-text);
    line-height: 1.6;
  }
  .event-hero__cta {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    background: var(--color-primary);
    color: white;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
    transition: background 0.2s ease;
  }
  .event-hero__cta:hover {
    background: var(--color-primary-dark);
  }
</style>
