---
import type { Review } from '../types';

interface Props {
  restaurantSlug: string;
  reviews: Review[];
}

const { restaurantSlug, reviews } = Astro.props;

function stars(value: number) {
  return '★'.repeat(value) + '☆'.repeat(5 - value);
}
---

<section class="review-list" data-review-list data-restaurant-slug={restaurantSlug}>
  <h3>Reseñas ({reviews.length})</h3>
  <ul data-review-list-items>
    {reviews.map((review) => (
      <li>
        <div class="review-list__header">
          <strong>{review.name}</strong>
          <span class="review-list__rating">{stars(review.rating)}</span>
        </div>
        {review.foodRating && review.serviceRating && review.ambianceRating && (
          <p class="review-list__breakdown">
            Comida {stars(review.foodRating)} · Servicio {stars(review.serviceRating)} · Ambiente {stars(review.ambianceRating)}
          </p>
        )}
        <p>{review.comment}</p>
      </li>
    ))}
  </ul>
  {reviews.length === 0 && <p data-review-empty>Todavía no hay reseñas. ¡Sé el primero!</p>}
</section>

<style>
  .review-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  .review-list li {
    padding: var(--spacing-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .review-list__header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }
  .review-list__rating {
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }
  .review-list__breakdown {
    margin: 0 0 0.25rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
</style>

<script>
  interface ReviewDTO {
    name: string;
    rating: number;
    foodRating?: number;
    serviceRating?: number;
    ambianceRating?: number;
    comment: string;
  }

  const container = document.querySelector<HTMLElement>('[data-review-list]');
  const list = container?.querySelector<HTMLUListElement>('[data-review-list-items]');
  const restaurantSlug = container?.dataset.restaurantSlug;

  function escapeHtml(value: string) {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function stars(value: number) {
    return '★'.repeat(value) + '☆'.repeat(5 - value);
  }

  function renderReviews(reviews: ReviewDTO[]) {
    if (!list || !container) return;
    const heading = container.querySelector('h3');
    if (heading) heading.textContent = `Reseñas (${reviews.length})`;

    list.innerHTML = reviews
      .map((review) => {
        const breakdown = review.foodRating && review.serviceRating && review.ambianceRating
          ? `<p class="review-list__breakdown">Comida ${stars(review.foodRating)} · Servicio ${stars(review.serviceRating)} · Ambiente ${stars(review.ambianceRating)}</p>`
          : '';
        return `
          <li>
            <div class="review-list__header">
              <strong>${escapeHtml(review.name)}</strong>
              <span class="review-list__rating">${stars(review.rating)}</span>
            </div>
            ${breakdown}
            <p>${escapeHtml(review.comment)}</p>
          </li>
        `;
      })
      .join('');
  }

  async function refresh() {
    if (!restaurantSlug) return;
    const response = await fetch(`/api/reviews?restaurant=${encodeURIComponent(restaurantSlug)}`);
    if (!response.ok) return;
    const reviews = (await response.json()) as ReviewDTO[];
    renderReviews(reviews);
  }

  document.addEventListener('review:created', (event) => {
    const detail = (event as CustomEvent<{ restaurantSlug: string }>).detail;
    if (detail?.restaurantSlug === restaurantSlug) refresh();
  });

  refresh();
</script>
