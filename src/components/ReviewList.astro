---
import type { Review } from '../types';

interface Props {
  restaurantSlug: string;
  reviews: Review[];
}

const { restaurantSlug, reviews } = Astro.props;

function stars(value: number) {
  return '★'.repeat(value) + '☆'.repeat(5 - value);
}
---

<section class="review-list" data-review-list data-restaurant-slug={restaurantSlug}>
  <h3>Reseñas ({reviews.length})</h3>
  <ul data-review-list-items>
    {reviews.map((review) => (
      <li>
        <div class="review-list__header">
          <strong>{review.name}</strong>
          <span class="review-list__rating">{stars(review.rating)}</span>
        </div>
        {review.foodRating && review.serviceRating && review.ambianceRating && (
          <p class="review-list__breakdown">
            Comida {stars(review.foodRating)} · Servicio {stars(review.serviceRating)} · Ambiente {stars(review.ambianceRating)}
          </p>
        )}
        <p>{review.comment}</p>

        {review.replies.length > 0 && (
          <ul class="review-list__replies">
            {review.replies.map((reply) => (
              <li>
                <strong>{reply.name}</strong>
                <span class="review-list__unverified" title="Cualquier persona puede publicar una respuesta; el restaurante todavía no tiene una cuenta verificada.">
                  Titular de la respuesta no verificado
                </span>
                <p>{reply.message}</p>
              </li>
            ))}
          </ul>
        )}

        <button type="button" class="review-list__reply-toggle" data-reply-toggle={review.id}>Responder</button>

        <form class="review-list__reply-form" data-reply-form={review.id} hidden>
          <h4>Responder</h4>
          <label class="review-list__reply-field">
            Nombre
            <input type="text" name="name" placeholder="Ej: Juan Pérez" required minlength="3" maxlength="30" />
          </label>
          <label class="review-list__reply-field">
            Celular
            <input type="tel" name="phone" placeholder="Ej: 11 2345 6789" required pattern="[0-9+\s()-]{7,20}" />
          </label>
          <label class="review-list__reply-field">
            Email
            <input type="email" name="email" placeholder="Ej: juan@email.com" required />
          </label>
          <p class="review-form__privacy">Tu celular y email no se publican, solo los usamos para contactarte.</p>
          <label class="review-list__reply-field">
            Respuesta
            <textarea name="message" placeholder="Escribí tu respuesta" required maxlength="300"></textarea>
          </label>
          <button type="submit">Enviar respuesta</button>
          <p class="review-list__reply-status" data-reply-status role="status"></p>
        </form>
      </li>
    ))}
  </ul>
  {reviews.length === 0 && <p data-review-empty>Todavía no hay reseñas. ¡Sé el primero!</p>}
</section>

<style>
  .review-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  /* El contenido de [data-review-list-items] se reemplaza por completo vía innerHTML en
     refresh() (se llama siempre al montar), así que esos elementos nunca reciben el atributo
     de scope de Astro. Todas las reglas que apuntan a ese contenido deben ser :global(). */
  :global(.review-list li) {
    padding: var(--spacing-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  :global(.review-list__header) {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }
  :global(.review-list__rating) {
    color: var(--color-accent-dark);
    letter-spacing: 0.1em;
  }
  :global(.review-list__breakdown) {
    margin: 0 0 0.25rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  :global(.review-list__replies) {
    margin: var(--spacing-xs) 0 0 var(--spacing-md);
    padding-left: var(--spacing-sm);
    border-left: 2px solid var(--color-border);
  }
  :global(.review-list__replies li) {
    padding: 0.4rem 0;
    background: none;
    border: none;
  }
  :global(.review-list__unverified) {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.1rem 0.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    vertical-align: middle;
  }
  :global(.review-list__reply-toggle) {
    margin-top: var(--spacing-xs);
    padding: 0.3rem 0.75rem;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-primary-dark);
    font-size: 0.85rem;
    cursor: pointer;
  }
  :global(.review-list__reply-toggle):hover {
    background: var(--color-accent);
  }
  :global(.review-list__reply-form) {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    margin-top: var(--spacing-sm);
    padding: var(--spacing-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  :global(.review-list__reply-form[hidden]) {
    display: none;
  }
  :global(.review-list__reply-form h4) {
    margin: 0 0 0.25rem;
    color: var(--color-primary-dark);
  }
  :global(.review-list__reply-field) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  :global(.review-list__reply-form .review-form__privacy) {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  :global(.review-list__reply-form input),
  :global(.review-list__reply-form textarea) {
    padding: 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) / 2);
    font: inherit;
  }
  :global(.review-list__reply-form button[type='submit']) {
    align-self: flex-start;
    padding: 0.6rem 1.5rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: var(--radius);
    font-weight: 600;
    cursor: pointer;
  }
  :global(.review-list__reply-form button[type='submit']):hover {
    background: var(--color-primary-dark);
  }
  :global(.review-list__reply-status) {
    margin: 0;
    font-size: 0.85rem;
    min-height: 1.1em;
  }
  :global(.review-list__reply-status[data-state='success']) {
    color: #2f7a3d;
  }
  :global(.review-list__reply-status[data-state='error']) {
    color: #b3261e;
  }
</style>

<script>
  interface ReplyDTO {
    name: string;
    message: string;
  }

  interface ReviewDTO {
    id: string;
    name: string;
    rating: number;
    foodRating?: number;
    serviceRating?: number;
    ambianceRating?: number;
    comment: string;
    replies: ReplyDTO[];
  }

  const container = document.querySelector<HTMLElement>('[data-review-list]');
  const list = container?.querySelector<HTMLUListElement>('[data-review-list-items]');
  const restaurantSlug = container?.dataset.restaurantSlug;

  function escapeHtml(value: string) {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function stars(value: number) {
    return '★'.repeat(value) + '☆'.repeat(5 - value);
  }

  function renderReviews(reviews: ReviewDTO[]) {
    if (!list || !container) return;
    const heading = container.querySelector('h3');
    if (heading) heading.textContent = `Reseñas (${reviews.length})`;
    // El contador de la pestaña "Valoraciones (N)" vive en [slug].astro, fuera de este
    // componente, y se renderiza una sola vez en el servidor — sin esto, queda desactualizado
    // después de publicar una reseña aunque el contador de acá adentro sí se actualice.
    const tabTrigger = document.querySelector('[data-tab-trigger="valoraciones"]');
    if (tabTrigger) tabTrigger.textContent = `Valoraciones (${reviews.length})`;

    list.innerHTML = reviews
      .map((review) => {
        const breakdown = review.foodRating && review.serviceRating && review.ambianceRating
          ? `<p class="review-list__breakdown">Comida ${stars(review.foodRating)} · Servicio ${stars(review.serviceRating)} · Ambiente ${stars(review.ambianceRating)}</p>`
          : '';
        const replies = review.replies.length > 0
          ? `<ul class="review-list__replies">${review.replies
              .map(
                (reply) =>
                  `<li><strong>${escapeHtml(reply.name)}</strong><span class="review-list__unverified" title="Cualquier persona puede publicar una respuesta; el restaurante todavía no tiene una cuenta verificada.">Titular de la respuesta no verificado</span><p>${escapeHtml(reply.message)}</p></li>`
              )
              .join('')}</ul>`
          : '';
        return `
          <li>
            <div class="review-list__header">
              <strong>${escapeHtml(review.name)}</strong>
              <span class="review-list__rating">${stars(review.rating)}</span>
            </div>
            ${breakdown}
            <p>${escapeHtml(review.comment)}</p>
            ${replies}
            <button type="button" class="review-list__reply-toggle" data-reply-toggle="${review.id}">Responder</button>
            <form class="review-list__reply-form" data-reply-form="${review.id}" hidden>
              <h4>Responder</h4>
              <label class="review-list__reply-field">
                Nombre
                <input type="text" name="name" placeholder="Ej: Juan Pérez" required minlength="3" maxlength="30" />
              </label>
              <label class="review-list__reply-field">
                Celular
                <input type="tel" name="phone" placeholder="Ej: 11 2345 6789" required pattern="[0-9+\\s()-]{7,20}" />
              </label>
              <label class="review-list__reply-field">
                Email
                <input type="email" name="email" placeholder="Ej: juan@email.com" required />
              </label>
              <p class="review-form__privacy">Tu celular y email no se publican, solo los usamos para contactarte.</p>
              <label class="review-list__reply-field">
                Respuesta
                <textarea name="message" placeholder="Escribí tu respuesta" required maxlength="300"></textarea>
              </label>
              <button type="submit">Enviar respuesta</button>
              <p class="review-list__reply-status" data-reply-status role="status"></p>
            </form>
          </li>
        `;
      })
      .join('');
  }

  async function refresh() {
    if (!restaurantSlug) return;
    const response = await fetch(`/api/reviews?restaurant=${encodeURIComponent(restaurantSlug)}`);
    if (!response.ok) return;
    const reviews = (await response.json()) as ReviewDTO[];
    renderReviews(reviews);
  }

  document.addEventListener('review:created', (event) => {
    const detail = (event as CustomEvent<{ restaurantSlug: string }>).detail;
    if (detail?.restaurantSlug === restaurantSlug) refresh();
  });

  container?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-reply-toggle]');
    if (!button) return;
    const reviewId = button.dataset.replyToggle;
    const form = container.querySelector<HTMLFormElement>(`[data-reply-form="${reviewId}"]`);
    if (form) form.hidden = !form.hidden;
  });

  container?.addEventListener('submit', async (event) => {
    const form = (event.target as HTMLElement).closest<HTMLFormElement>('[data-reply-form]');
    if (!form) return;
    event.preventDefault();

    const reviewId = form.dataset.replyForm;
    const status = form.querySelector<HTMLParagraphElement>('[data-reply-status]');
    const formData = new FormData(form);

    try {
      const response = await fetch('/api/review-replies', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          reviewId,
          name: formData.get('name'),
          phone: formData.get('phone'),
          email: formData.get('email'),
          message: formData.get('message'),
        }),
      });

      if (!response.ok) {
        const body = await response.json().catch(() => null);
        if (status) {
          status.textContent =
            response.status === 400
              ? 'Revisá el nombre, el celular, el email y el mensaje: alguno tiene un formato inválido.'
              : (body?.error ?? 'No pudimos publicar tu respuesta. Intentá de nuevo.');
          status.dataset.state = 'error';
        }
        return;
      }

      form.reset();
      if (status) {
        status.textContent = '¡Gracias por tu respuesta!';
        status.dataset.state = 'success';
      }
      document.dispatchEvent(new CustomEvent('review:created', { detail: { restaurantSlug } }));
    } catch {
      if (status) {
        status.textContent = 'No pudimos publicar tu respuesta. Revisá tu conexión e intentá de nuevo.';
        status.dataset.state = 'error';
      }
    }
  });

  refresh();
</script>
