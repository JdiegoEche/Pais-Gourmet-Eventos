---
interface Props {
  priceRanges: string[];
}

const { priceRanges } = Astro.props;
---

{priceRanges.length > 0 && (
  <section class="price-mosaic">
    <h2>Restaurantes por precio</h2>
    <div class="price-mosaic__grid">
      {priceRanges.map((range) => (
        <a class="price-mosaic__tile" href="/restaurantes-participantes">
          {range}
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .price-mosaic {
    padding: var(--spacing-lg) var(--spacing-md);
    max-width: 1100px;
    margin: 0 auto;
  }
  .price-mosaic h2 {
    color: var(--color-primary-dark);
  }
  .price-mosaic__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--spacing-md);
  }
  .price-mosaic__tile {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-lg) var(--spacing-md);
    background: var(--color-primary);
    color: white;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    text-align: center;
    transition: background 0.2s ease;
  }
  .price-mosaic__tile:hover {
    background: var(--color-primary-dark);
  }
</style>
