---
import type { PriceRangeItem } from '../types';
import { thumb, thumbSrcSet } from '../lib/image';

interface Props {
  priceRanges: PriceRangeItem[];
}

const { priceRanges } = Astro.props;
---

{priceRanges.length > 0 && (
  <section class="price-mosaic">
    <h2>Restaurantes por precio</h2>
    <div class="price-mosaic__grid">
      {priceRanges.map((item) => (
        <a class="price-mosaic__tile" href="/restaurantes-participantes">
          <img
            src={thumb(item.imageUrl, 500)}
            srcset={thumbSrcSet(item.imageUrl, [280, 500])}
            sizes="(max-width: 600px) 45vw, 280px"
            alt={item.range}
            loading="lazy"
          />
          <span>{item.range}</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .price-mosaic {
    padding: var(--spacing-lg) var(--spacing-md);
    max-width: 1100px;
    margin: 0 auto;
  }
  .price-mosaic h2 {
    color: var(--color-primary-dark);
  }
  .price-mosaic__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-md);
  }
  .price-mosaic__tile {
    position: relative;
    display: block;
    flex: 1 1 220px;
    max-width: 280px;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
  }
  .price-mosaic__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .price-mosaic__tile span {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--spacing-sm);
    background: linear-gradient(180deg, transparent, rgba(20, 14, 8, 0.75));
    color: white;
    font-weight: 700;
    font-size: 1.1rem;
  }
</style>
