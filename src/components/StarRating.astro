---
interface Props {
  name: string;
  label: string;
}

const { name, label } = Astro.props;
const STARS = [5, 4, 3, 2, 1] as const;
---

<fieldset class="star-rating">
  <legend class="star-rating__legend"><strong>{label} <span class="required-marker" aria-hidden="true">*</span></strong></legend>
  <div class="star-rating__stars">
    {STARS.map((value) => (
      <>
        <input type="radio" id={`${name}-${value}`} name={name} value={value} required />
        <label for={`${name}-${value}`} aria-label={`${value} de 5 estrellas`}>★</label>
      </>
    ))}
  </div>
</fieldset>

<style>
  .star-rating {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border: none;
    padding: 0;
    margin: 0;
  }
  .star-rating__legend {
    padding: 0;
    font-size: 0.9rem;
    color: var(--color-text);
  }
  .required-marker {
    color: #b3261e;
  }
  .star-rating__stars {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 0.15rem;
  }
  .star-rating__stars input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .star-rating__stars label {
    cursor: pointer;
    font-size: 1.8rem;
    line-height: 1;
    color: var(--color-border);
    transition: color 0.15s ease;
  }
  .star-rating__stars input:checked ~ label {
    color: var(--color-primary);
  }
  .star-rating__stars label:hover,
  .star-rating__stars label:hover ~ label {
    color: var(--color-primary);
  }
  .star-rating__stars input:focus-visible + label {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
