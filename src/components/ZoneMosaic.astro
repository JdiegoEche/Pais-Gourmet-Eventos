---
import type { ZoneShowcaseItem } from '../types';
import { thumb } from '../lib/image';

interface Props {
  zones: ZoneShowcaseItem[];
}

const { zones } = Astro.props;
---

{zones.length > 0 && (
  <section class="zone-mosaic">
    <h2>Restaurantes por zona</h2>
    <div class="zone-mosaic__grid">
      {zones.map((zone) => (
        <a class="zone-mosaic__tile" href={`/restaurantes-participantes?zone=${encodeURIComponent(zone.name)}`}>
          <img src={thumb(zone.imageUrl, 500)} alt={zone.name} loading="lazy" />
          <span>{zone.name}</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .zone-mosaic {
    padding: var(--spacing-lg) var(--spacing-md);
    max-width: 1100px;
    margin: 0 auto;
  }
  .zone-mosaic h2 {
    color: var(--color-primary-dark);
  }
  .zone-mosaic__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-md);
  }
  .zone-mosaic__tile {
    position: relative;
    display: block;
    flex: 1 1 240px;
    max-width: 300px;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
  }
  .zone-mosaic__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .zone-mosaic__tile span {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--spacing-sm);
    background: linear-gradient(180deg, transparent, rgba(20, 14, 8, 0.75));
    color: white;
    font-weight: 700;
    font-size: 1.1rem;
  }
</style>
