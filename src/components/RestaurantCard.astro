---
import type { Restaurant } from '../types';
import { thumb, PLACEHOLDER_IMAGE } from '../lib/image';

interface Props {
  restaurant: Restaurant;
}

const { restaurant } = Astro.props;
const cheapestMenu = [...restaurant.menus].sort((a, b) => a.currentPrice - b.currentPrice)[0];
const activeFeatures = Object.entries(restaurant.features)
  .filter(([key, value]) => key !== 'paymentMethods' && value === true)
  .map(([key]) => key);
const galleryUrls = restaurant.gallery.length > 0 ? restaurant.gallery.map((url) => thumb(url, 480)) : [PLACEHOLDER_IMAGE];
---

<a
  class="restaurant-card"
  href={`/restaurante/${restaurant.slug}`}
  data-restaurant-card
  data-cuisine={restaurant.cuisineTypes.join('|')}
  data-zone={restaurant.zone.join('|')}
  data-delivery-zones={restaurant.deliveryZones.join('|')}
  data-prices={restaurant.menus.map((menu) => menu.currentPrice).join('|')}
  data-vegetarian={restaurant.vegetarianOption}
  data-features={activeFeatures.join('|')}
  data-name={restaurant.name}
>
  <div class="restaurant-card__image" data-carousel data-gallery={galleryUrls.join('|')}>
    <img src={galleryUrls[0]} alt={restaurant.name} loading="lazy" decoding="async" width="480" height="480" data-carousel-img />
    {galleryUrls.length > 1 && (
      <>
        <button type="button" class="restaurant-card__nav restaurant-card__nav--prev" data-carousel-prev aria-label="Foto anterior">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="restaurant-card__nav restaurant-card__nav--next" data-carousel-next aria-label="Foto siguiente">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </>
    )}
  </div>
  <div class="restaurant-card__body">
    <h3>{restaurant.name}</h3>
    <p class="restaurant-card__meta">{[restaurant.cuisineTypes.join(', '), restaurant.zone.join(', ')].filter(Boolean).join(' · ')}</p>
    {cheapestMenu && <p class="restaurant-card__price">Desde ${cheapestMenu.currentPrice.toLocaleString('es-CO')}</p>}
  </div>
</a>

<style>
  .restaurant-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .restaurant-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(43, 33, 24, 0.16);
  }
  .restaurant-card[hidden] {
    display: none;
  }
  .restaurant-card__image {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .restaurant-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .restaurant-card__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: none;
    border-radius: 50%;
    background: rgba(20, 14, 8, 0.55);
    color: white;
    cursor: pointer;
    transition: opacity 0.2s ease, background 0.2s ease;
  }
  .restaurant-card__nav:hover {
    background: rgba(20, 14, 8, 0.8);
  }
  @media (hover: hover) and (pointer: fine) {
    .restaurant-card__nav {
      opacity: 0;
    }
    .restaurant-card__image:hover .restaurant-card__nav {
      opacity: 1;
    }
  }
  .restaurant-card__nav--prev {
    left: 0.5rem;
  }
  .restaurant-card__nav--next {
    right: 0.5rem;
  }
  .restaurant-card__body {
    padding: var(--spacing-sm);
  }
  .restaurant-card__body h3 {
    margin: 0 0 0.25rem;
    color: var(--color-primary-dark);
  }
  .restaurant-card__meta {
    margin: 0 0 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .restaurant-card__price {
    margin: 0;
    font-weight: 700;
    color: var(--color-primary);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const gallery = carousel.dataset.gallery?.split('|') ?? [];
    const img = carousel.querySelector<HTMLImageElement>('[data-carousel-img]');
    if (!img || gallery.length < 2) return;

    let index = 0;
    function show(next: number) {
      index = (next + gallery.length) % gallery.length;
      if (img) img.src = gallery[index];
    }

    carousel.querySelector('[data-carousel-prev]')?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      show(index - 1);
    });
    carousel.querySelector('[data-carousel-next]')?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      show(index + 1);
    });
  });
</script>
