---
import type { Restaurant } from '../types';
import RestaurantCard from './RestaurantCard.astro';

interface Props {
  restaurants: Restaurant[];
}

const { restaurants } = Astro.props;
---

{restaurants.length > 0 && (
  <section class="hero-recommended">
    <h2>Restaurantes recomendados</h2>
    <div class="hero-recommended__viewport">
      <div class="hero-recommended__track" data-hero-recommended-track>
        {restaurants.map((restaurant) => (
          <div class="hero-recommended__item">
            <RestaurantCard restaurant={restaurant} />
          </div>
        ))}
      </div>
      {restaurants.length > 1 && (
        <>
          <button type="button" class="hero-recommended__nav hero-recommended__nav--prev" data-hero-recommended-prev aria-label="Restaurantes anteriores">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button type="button" class="hero-recommended__nav hero-recommended__nav--next" data-hero-recommended-next aria-label="Restaurantes siguientes">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </>
      )}
    </div>
  </section>
)}

<style>
  .hero-recommended {
    padding: var(--spacing-lg) var(--spacing-md);
    max-width: 1100px;
    margin: 0 auto;
  }
  .hero-recommended h2 {
    color: var(--color-primary-dark);
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0 0 var(--spacing-md);
  }
  .hero-recommended__viewport {
    position: relative;
  }
  .hero-recommended__track {
    display: flex;
    gap: var(--spacing-md);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
  }
  .hero-recommended__track::-webkit-scrollbar {
    display: none;
  }
  .hero-recommended__item {
    flex: 0 0 260px;
    scroll-snap-align: start;
  }
  .hero-recommended__nav {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: none;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: 0 1px 3px rgba(43, 33, 24, 0.15), 0 4px 12px rgba(43, 33, 24, 0.1);
    cursor: pointer;
  }
  .hero-recommended__nav:hover {
    background: var(--color-accent);
  }
  .hero-recommended__nav--prev {
    left: -1.375rem;
  }
  .hero-recommended__nav--next {
    right: -1.375rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-recommended__track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero-recommended-track]').forEach((track) => {
    const section = track.closest('.hero-recommended');
    const prev = section?.querySelector<HTMLButtonElement>('[data-hero-recommended-prev]');
    const next = section?.querySelector<HTMLButtonElement>('[data-hero-recommended-next]');
    const scrollBehavior: ScrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ? 'auto'
      : 'smooth';

    function scrollByCard(direction: 1 | -1) {
      const item = track.querySelector<HTMLElement>('.hero-recommended__item');
      const step = (item?.clientWidth ?? track.clientWidth) + 16;
      track.scrollBy({ left: step * direction, behavior: scrollBehavior });
    }

    prev?.addEventListener('click', () => scrollByCard(-1));
    next?.addEventListener('click', () => scrollByCard(1));
  });
</script>
