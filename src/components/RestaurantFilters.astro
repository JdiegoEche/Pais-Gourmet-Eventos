---
interface Props {
  cuisineTypes: string[];
  zones: string[];
  deliveryZones: string[];
  priceRanges: string[];
}

const { cuisineTypes, zones, deliveryZones, priceRanges } = Astro.props;
---

<aside class="restaurant-filters-outer">
 <div class="restaurant-filters">
  <div class="restaurant-filters__bar">
    <div class="restaurant-filters__field restaurant-filters__search-field">
      <label for="filter-search" class="restaurant-filters__search-label">Buscar restaurante</label>
      <input
        type="search"
        id="filter-search"
        placeholder="Busca un restaurante"
        data-filter-search
      />
    </div>
    <button type="button" class="restaurant-filters__toggle" data-filters-toggle aria-expanded="false">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polygon points="22 3 2 3 10 12.5 10 20 14 22 14 12.5 22 3" />
      </svg>
      Filtros
    </button>
  </div>

  <form data-filters class="restaurant-filters__panel" data-filters-panel>
    <div class="restaurant-filters__field">
      <label for="filter-price">Valor del menú para 2 personas</label>
      <select id="filter-price" name="priceRange" data-filter-price>
        <option value="">Todos</option>
        {priceRanges.map((range) => <option value={range}>{range}</option>)}
      </select>
    </div>

    <div class="restaurant-filters__field">
      <label for="filter-zone">Restaurantes por zonas</label>
      <select id="filter-zone" name="zone" data-filter-zone>
        <option value="">Todas</option>
        {zones.map((zone) => <option value={zone}>{zone}</option>)}
      </select>
    </div>

    <div class="restaurant-filters__field">
      <label for="filter-delivery-zone">Zonas a domicilio</label>
      <select id="filter-delivery-zone" name="deliveryZone" data-filter-delivery-zone>
        <option value="">Todas</option>
        {deliveryZones.map((zone) => <option value={zone}>{zone}</option>)}
      </select>
    </div>

    <div class="restaurant-filters__field">
      <label for="filter-cuisine">Tipo de comida</label>
      <select id="filter-cuisine" name="cuisine" data-filter-cuisine>
        <option value="">Todos</option>
        {cuisineTypes.map((type) => <option value={type}>{type}</option>)}
      </select>
    </div>

    <fieldset>
      <legend>Opciones alimenticias</legend>
      <label>
        <input type="checkbox" name="vegetarian" value="true" />
        Menú con opción vegetariana
      </label>
    </fieldset>

    <fieldset>
      <legend>Características del restaurante</legend>
      <label>
        <input type="checkbox" name="feature" value="parking" />
        Parqueadero
      </label>
      <label>
        <input type="checkbox" name="feature" value="petFriendly" />
        Petfriendly
      </label>
      <label>
        <input type="checkbox" name="feature" value="delivery" />
        Servicio a domicilio
      </label>
      <label>
        <input type="checkbox" name="feature" value="tableService" />
        Atención en mesa
      </label>
      <label>
        <input type="checkbox" name="feature" value="creditCard" />
        Tarjeta crédito/débito
      </label>
    </fieldset>

    <button type="button" data-filters-clear>Limpiar filtros</button>
  </form>
 </div>
</aside>

<style>
  .restaurant-filters {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    position: sticky;
    top: calc(var(--header-height) + var(--spacing-xs));
    z-index: 10;
  }
  .restaurant-filters__bar {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .restaurant-filters__toggle {
    display: none;
  }
  .restaurant-filters__panel {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  .restaurant-filters__field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .restaurant-filters__field > label:first-child {
    font-weight: 700;
    color: var(--color-primary-dark);
  }
  .restaurant-filters__field input[type='search'],
  .restaurant-filters__field select {
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.9rem;
  }
  .restaurant-filters fieldset {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .restaurant-filters legend {
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 0.25rem;
    padding: 0;
  }
  .restaurant-filters label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    color: var(--color-text);
  }
  .restaurant-filters [data-filters-clear] {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .restaurant-filters__bar {
      flex-direction: row;
      align-items: center;
      gap: var(--spacing-sm);
    }
    .restaurant-filters__search-field {
      flex: 1;
      min-width: 0;
    }
    .restaurant-filters__search-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
    .restaurant-filters__toggle {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: none;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 0.5rem 0.75rem;
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--color-text);
      cursor: pointer;
      white-space: nowrap;
    }
    .restaurant-filters__panel {
      display: none;
    }
    .restaurant-filters__panel.restaurant-filters__panel--open {
      display: flex;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-restaurant-grid]');
  const counter = document.querySelector<HTMLElement>('[data-results-count]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-filter-search]');
  const filtersToggle = document.querySelector<HTMLButtonElement>('[data-filters-toggle]');
  const filtersPanel = document.querySelector<HTMLElement>('[data-filters-panel]');
  const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('[data-restaurant-card]')) : [];

  function normalize(value: string): string {
    return value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '');
  }

  function parsePriceRange(range: string): { min: number; max: number } | null {
    const numbers = range.match(/[\d.]+/g)?.map((n) => Number(n.replace(/\./g, '')));
    if (!numbers || numbers.length < 2) return null;
    return { min: numbers[0], max: numbers[1] };
  }

  const initialParams = new URLSearchParams(window.location.search);
  let searchQuery = normalize(initialParams.get('q') ?? '');
  if (searchInput) searchInput.value = initialParams.get('q') ?? '';

  const BATCH_SIZE = 24;
  let visibleCount = BATCH_SIZE;
  let totalMatches = 0;

  function matchesFilters(card: HTMLElement): boolean {
    if (!form) return true;
    const cuisine = form.querySelector<HTMLSelectElement>('[data-filter-cuisine]')?.value ?? '';
    const zone = form.querySelector<HTMLSelectElement>('[data-filter-zone]')?.value ?? '';
    const deliveryZone = form.querySelector<HTMLSelectElement>('[data-filter-delivery-zone]')?.value ?? '';
    const features = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="feature"]:checked')).map(
      (el) => el.value
    );
    const vegetarianOnly = form.querySelector<HTMLInputElement>('input[name="vegetarian"]')?.checked ?? false;
    const priceRangeValue = form.querySelector<HTMLSelectElement>('[data-filter-price]')?.value ?? '';
    const priceRange = priceRangeValue ? parsePriceRange(priceRangeValue) : null;

    const cardCuisines = card.dataset.cuisine?.split('|') ?? [];
    const cardZone = card.dataset.zone ?? '';
    const cardDeliveryZones = card.dataset.deliveryZones ? card.dataset.deliveryZones.split('|') : [];
    const cardFeatures = card.dataset.features ? card.dataset.features.split('|') : [];
    const cardPrices = card.dataset.prices ? card.dataset.prices.split('|').map(Number) : [];
    const cardVegetarian = card.dataset.vegetarian === 'true';
    const cardName = normalize(card.dataset.name ?? '');

    const matchesCuisine = !cuisine || cardCuisines.includes(cuisine);
    const matchesZone = !zone || cardZone === zone;
    const matchesDeliveryZone = !deliveryZone || cardDeliveryZones.includes(deliveryZone);
    const matchesFeatures = features.every((f) => cardFeatures.includes(f));
    const matchesVegetarian = !vegetarianOnly || cardVegetarian;
    const matchesPrice = !priceRange || cardPrices.some((p) => p >= priceRange!.min && p <= priceRange!.max);
    const matchesSearch = searchQuery.length === 0 || cardName.includes(searchQuery);

    return (
      matchesCuisine &&
      matchesZone &&
      matchesDeliveryZone &&
      matchesFeatures &&
      matchesVegetarian &&
      matchesPrice &&
      matchesSearch
    );
  }

  // Solo revela hasta `visibleCount` tarjetas entre las que matchean, sin recalcular el filtro.
  // La usa el IntersectionObserver para ir mostrando más de a tandas al hacer scroll.
  function revealVisible() {
    let matchIndex = 0;
    cards.forEach((card) => {
      if (card.dataset.filterMatch !== 'true') {
        card.hidden = true;
        return;
      }
      matchIndex += 1;
      card.hidden = matchIndex > visibleCount;
    });
    totalMatches = matchIndex;
    if (counter) counter.textContent = String(Math.min(visibleCount, totalMatches));
  }

  function applyFilters() {
    cards.forEach((card) => {
      card.dataset.filterMatch = String(matchesFilters(card));
    });
    visibleCount = BATCH_SIZE;
    revealVisible();
  }

  const sentinel = document.querySelector<HTMLElement>('[data-restaurant-sentinel]');
  const observer = new IntersectionObserver(
    (entries) => {
      if (entries[0]?.isIntersecting && visibleCount < totalMatches) {
        visibleCount += BATCH_SIZE;
        revealVisible();
      }
    },
    { rootMargin: '400px' }
  );
  if (sentinel) observer.observe(sentinel);

  form?.addEventListener('change', applyFilters);
  searchInput?.addEventListener('input', () => {
    searchQuery = normalize(searchInput.value);
    applyFilters();
  });
  document.querySelector('[data-filters-clear]')?.addEventListener('click', () => {
    form?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((el) => (el.checked = false));
    form?.querySelectorAll<HTMLSelectElement>('select').forEach((el) => (el.value = ''));
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    applyFilters();
  });

  filtersToggle?.addEventListener('click', () => {
    const isOpen = filtersPanel?.classList.toggle('restaurant-filters__panel--open') ?? false;
    filtersToggle.setAttribute('aria-expanded', String(isOpen));
  });

  const zoneParam = initialParams.get('zone');
  if (zoneParam && form) {
    const zoneSelect = form.querySelector<HTMLSelectElement>('[data-filter-zone]');
    if (zoneSelect && Array.from(zoneSelect.options).some((o) => o.value === zoneParam)) {
      zoneSelect.value = zoneParam;
    }
  }
  applyFilters();
</script>
