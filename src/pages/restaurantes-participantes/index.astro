---
import Layout from '../../layouts/Layout.astro';
import RestaurantCard from '../../components/RestaurantCard.astro';
import RestaurantFilters from '../../components/RestaurantFilters.astro';
import { getAllRestaurants, getEvent } from '../../lib/data';

const restaurants = await getAllRestaurants();
const event = await getEvent();
const cuisineTypes = [...new Set(restaurants.flatMap((r) => r.cuisineTypes))];
const zones = [...new Set(restaurants.map((r) => r.zone))];
const deliveryZones = [...new Set(restaurants.flatMap((r) => r.deliveryZones))];
const priceRanges = event?.priceRanges.map((p) => p.range) ?? [];
---

<Layout title="Restaurantes participantes">
  <section class="restaurant-listing">
    <div class="restaurant-listing__layout">
      <RestaurantFilters
        cuisineTypes={cuisineTypes}
        zones={zones}
        deliveryZones={deliveryZones}
        priceRanges={priceRanges}
      />
      <div class="restaurant-listing__main">
        <p class="restaurant-listing__count">
          Mostrando <span data-results-count>{restaurants.length}</span> de {restaurants.length} restaurantes
        </p>
        <div class="restaurant-listing__grid" data-restaurant-grid>
          {restaurants.map((restaurant) => <RestaurantCard restaurant={restaurant} />)}
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .restaurant-listing {
    padding: var(--spacing-lg) var(--spacing-md);
    max-width: 1600px;
    margin: 0 auto;
  }
  .restaurant-listing__layout {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-lg);
  }
  .restaurant-listing__layout > :global(aside) {
    flex: 0 0 260px;
    min-height: 100vh;
  }
  .restaurant-listing__main {
    flex: 1;
    min-width: 0;
  }
  .restaurant-listing__count {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-sm);
  }
  .restaurant-listing__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--spacing-md);
  }
  @media (max-width: 768px) {
    .restaurant-listing__layout {
      flex-direction: column;
    }
    .restaurant-listing__layout > :global(aside) {
      flex-basis: auto;
      width: 100%;
      min-height: 0;
      position: static;
    }
  }
  @media (max-width: 600px) {
    .restaurant-listing__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-sm);
    }
  }
</style>
