---
import Layout from '../../layouts/Layout.astro';
import RestaurantCard from '../../components/RestaurantCard.astro';
import RestaurantFilters from '../../components/RestaurantFilters.astro';
import { getAllRestaurants } from '../../lib/data';

const restaurants = await getAllRestaurants();
const cuisineTypes = [...new Set(restaurants.flatMap((r) => r.cuisineTypes))];
const zones = [...new Set(restaurants.map((r) => r.zone))];
---

<Layout title="Restaurantes participantes">
  <section class="restaurant-listing">
    <h1>Restaurantes participantes</h1>
    <RestaurantFilters cuisineTypes={cuisineTypes} zones={zones} />
    <p class="restaurant-listing__count">
      Mostrando <span data-results-count>{restaurants.length}</span> de {restaurants.length} restaurantes
    </p>
    <div class="restaurant-listing__grid" data-restaurant-grid>
      {restaurants.map((restaurant) => <RestaurantCard restaurant={restaurant} />)}
    </div>
  </section>
</Layout>

<style>
  .restaurant-listing {
    padding: var(--spacing-lg) var(--spacing-md);
    max-width: 1100px;
    margin: 0 auto;
  }
  .restaurant-listing h1 {
    color: var(--color-primary-dark);
  }
  .restaurant-listing__count {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-sm);
  }
  .restaurant-listing__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--spacing-md);
  }
</style>
