---
import Layout from '../layouts/Layout.astro';
import EventHero from '../components/EventHero.astro';
import HeroRecommended from '../components/HeroRecommended.astro';
import RestaurantCard from '../components/RestaurantCard.astro';
import RestaurantLogoStrip from '../components/RestaurantLogoStrip.astro';
import WhatIncludesShowcase from '../components/WhatIncludesShowcase.astro';
import PriceMosaic from '../components/PriceMosaic.astro';
import ZoneMosaic from '../components/ZoneMosaic.astro';
import RotatingBanner from '../components/RotatingBanner.astro';
import SignupForm from '../components/SignupForm.astro';
import SponsorsSection from '../components/SponsorsSection.astro';
import { getEvent, getFeaturedRestaurants, getAllRestaurants, getHeroRecommendedRestaurants } from '../lib/data';

const [event, allRestaurants] = await Promise.all([getEvent(), getAllRestaurants()]);
const [featuredRestaurants, heroRecommended] = await Promise.all([
  getFeaturedRestaurants(event),
  getHeroRecommendedRestaurants(event),
]);
---

<Layout title={event?.name ?? 'País Gourmet'}>
  {event && <EventHero event={event} />}
  <section class="featured-restaurants">
    <h2>Restaurantes destacados</h2>
    <div class="featured-restaurants__grid">
      {featuredRestaurants.map((restaurant) => <RestaurantCard restaurant={restaurant} />)}
    </div>
  </section>
  <RestaurantLogoStrip restaurants={allRestaurants} />
  {event && <WhatIncludesShowcase imageUrl={event.whatIncludesImage} />}
  <HeroRecommended restaurants={heroRecommended} />
  {event && <PriceMosaic priceRanges={event.priceRanges} />}
  {event && <ZoneMosaic zones={event.zoneShowcase} />}
  {event && <RotatingBanner images={event.banners} />}
  <SignupForm />
  {event && <SponsorsSection sponsors={event.sponsorLogos} />}
</Layout>

<style>
  .featured-restaurants {
    padding: var(--spacing-lg) var(--spacing-md);
    max-width: 1100px;
    margin: 0 auto;
  }
  .featured-restaurants h2 {
    color: var(--color-primary-dark);
  }
  .featured-restaurants__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--spacing-md);
  }
</style>
