---
import Layout from '../../layouts/Layout.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import ReviewForm from '../../components/ReviewForm.astro';
import ReviewList from '../../components/ReviewList.astro';
import RestaurantCard from '../../components/RestaurantCard.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getAllRestaurants, getReviews, getRelatedRestaurants } from '../../lib/data';
import type { Restaurant } from '../../types';

export async function getStaticPaths() {
  const restaurants = await getAllRestaurants();
  return restaurants.map((restaurant) => ({
    params: { slug: restaurant.slug },
    props: { restaurant },
  }));
}

interface Props {
  restaurant: Restaurant;
}

const { restaurant } = Astro.props;
const reviews = await getReviews(restaurant.slug);
const relatedRestaurants = await getRelatedRestaurants(restaurant);

const dayLabels: Record<string, string> = {
  lunes: 'Lunes',
  martes: 'Martes',
  miercoles: 'Miércoles',
  jueves: 'Jueves',
  viernes: 'Viernes',
  sabado: 'Sábado',
  domingo: 'Domingo',
};

const menuCategories = ['entrantes', 'fuerte', 'postre'] as const;

function youtubeEmbedUrl(url?: string): string | null {
  if (!url) return null;
  try {
    const parsed = new URL(url);
    if (parsed.hostname.includes('youtu.be')) {
      return `https://www.youtube.com/embed${parsed.pathname}`;
    }
    const videoId = parsed.searchParams.get('v');
    if (videoId) return `https://www.youtube.com/embed/${videoId}`;
    if (parsed.pathname.startsWith('/embed/')) return url;
    return null;
  } catch {
    return null;
  }
}

const videoEmbedUrl = youtubeEmbedUrl(restaurant.youtubeVideoUrl);
---

<Layout title={restaurant.name}>
  <article class="restaurant-detail">
    <header class="restaurant-detail__header">
      <h1>{restaurant.name}</h1>
      <p class="restaurant-detail__meta">{restaurant.cuisineTypes.join(', ')} · {restaurant.zone}</p>
    </header>

    <PhotoGallery photos={restaurant.gallery} alt={restaurant.name} />

    <div class="restaurant-detail__tabs" role="tablist" aria-label="Secciones del restaurante">
      <button
        type="button"
        class="restaurant-detail__tab"
        role="tab"
        id="tab-info"
        aria-controls="panel-info"
        aria-selected="true"
        data-tab-trigger="info"
      >
        Información
      </button>
      <button
        type="button"
        class="restaurant-detail__tab"
        role="tab"
        id="tab-valoraciones"
        aria-controls="panel-valoraciones"
        aria-selected="false"
        tabindex="-1"
        data-tab-trigger="valoraciones"
      >
        Valoraciones ({reviews.length})
      </button>
    </div>

    <div id="panel-info" role="tabpanel" aria-labelledby="tab-info" data-tab-panel="info">
      <div class:list={['restaurant-detail__grid', !videoEmbedUrl && 'restaurant-detail__grid--no-video']}>
        <section class="restaurant-detail__menus">
          <h2>Menús</h2>
          {restaurant.menus.map((menu) => (
            <div class="menu-card">
              <div class="menu-card__header">
                <h3>{menu.name}</h3>
                <div class="menu-card__price">
                  {menu.previousPrice && (
                    <span class="menu-card__price--before">${menu.previousPrice.toLocaleString('es-CO')}</span>
                  )}
                  <span class="menu-card__price--current">${menu.currentPrice.toLocaleString('es-CO')}</span>
                </div>
              </div>
              {menuCategories.map((category) => {
                const items = menu.items.filter((item) => item.category === category);
                if (items.length === 0) return null;
                return (
                  <div class="menu-card__category">
                    <h4>{category}</h4>
                    <ul>
                      {items.map((item) => (
                        <li>
                          {item.name}
                          {item.description && <span> — {item.description}</span>}
                        </li>
                      ))}
                    </ul>
                  </div>
                );
              })}
            </div>
          ))}

          {restaurant.menuHighlights.length > 0 && (
            <ul class="restaurant-detail__menu-highlights">
              {restaurant.menuHighlights.map((highlight) => (
                <li>
                  <img src={highlight.icon} alt="" />
                  <span>{highlight.label}</span>
                </li>
              ))}
            </ul>
          )}

          <div class="restaurant-detail__general-info">
            <h2>Información general</h2>
            <p>{restaurant.address}</p>
            <p><a href={`tel:${restaurant.phone}`}>{restaurant.phone}</a></p>

            <h3>Horarios</h3>
            <ul class="restaurant-detail__hours">
              {restaurant.hours.map((h) => (
                <li>{dayLabels[h.day] ?? h.day}: {h.opens} – {h.closes}</li>
              ))}
            </ul>
          </div>
        </section>

        {videoEmbedUrl && (
          <section class="restaurant-detail__video">
            <div class="restaurant-detail__video-frame">
              <iframe
                src={videoEmbedUrl}
                title={`Video de ${restaurant.name}`}
                loading="lazy"
                allowfullscreen
              ></iframe>
            </div>
          </section>
        )}
      </div>

      <div class="feature-section">
        <div class="feature-item">
          <h3>Características</h3>
          <ul class="restaurant-detail__features">
            {restaurant.features.parking && <li>Parqueadero</li>}
            {restaurant.features.petFriendly && <li>Pet friendly</li>}
            {restaurant.features.delivery && <li>Delivery</li>}
            {restaurant.features.tableService && <li>Servicio a la mesa</li>}
            {restaurant.features.creditCard && <li>Tarjeta de crédito</li>}
          </ul>
        </div>

        <div class="feature-item">
          <h3>Contacto</h3>
          {restaurant.whatsapp && (
            <p><a href={`https://wa.me/${restaurant.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a></p>
          )}
          {restaurant.instagram && (
            <p>
              <a href={`https://instagram.com/${restaurant.instagram}`} target="_blank" rel="noopener">
                @{restaurant.instagram}
              </a>
            </p>
          )}
          <ShareButtons title={restaurant.name} />
        </div>

        <div class="feature-item">
          <h3>Opciones alimenticias</h3>
          <ul class="restaurant-detail__features">
            {restaurant.vegetarianOption && <li>Opción vegetariana</li>}
          </ul>
        </div>

        <div class="feature-item">
          <h3>Tipos de cocina</h3>
          <ul class="restaurant-detail__features">
            {restaurant.cuisineTypes.map((type) => <li>{type}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <section
      class="restaurant-detail__reviews"
      id="panel-valoraciones"
      role="tabpanel"
      aria-labelledby="tab-valoraciones"
      data-tab-panel="valoraciones"
      hidden
    >
      <ReviewList restaurantSlug={restaurant.slug} reviews={reviews} />
      <ReviewForm restaurantSlug={restaurant.slug} />
    </section>

    {relatedRestaurants.length > 0 && (
      <section class="restaurant-detail__related">
        <h2>Recomendados para ti</h2>
        <div class="restaurant-detail__related-grid">
          {relatedRestaurants.map((related) => (
            <RestaurantCard restaurant={related} />
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .restaurant-detail {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--spacing-lg) var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }
  .restaurant-detail__header h1 {
    color: var(--color-primary-dark);
    margin-bottom: 0.25rem;
  }
  .restaurant-detail__meta {
    color: var(--color-text-muted);
  }
  .restaurant-detail__tabs {
    display: flex;
    gap: var(--spacing-sm);
    border-bottom: 1px solid var(--color-border);
  }
  .restaurant-detail__tab {
    padding: 0.75rem 1rem;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    font: inherit;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .restaurant-detail__tab:hover {
    color: var(--color-primary-dark);
  }
  .restaurant-detail__tab[aria-selected='true'] {
    color: var(--color-primary-dark);
    border-bottom-color: var(--color-primary);
  }
  [data-tab-panel][hidden] {
    display: none;
  }
  .restaurant-detail__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--spacing-lg);
  }
  .restaurant-detail__grid--no-video {
    grid-template-columns: 1fr;
  }
  .restaurant-detail__menu-highlights {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin: var(--spacing-sm) 0;
  }
  .restaurant-detail__menu-highlights li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
  }
  .restaurant-detail__menu-highlights img {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
  }
  .restaurant-detail__general-info {
    margin-top: var(--spacing-md);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border);
  }
  .restaurant-detail__video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .restaurant-detail__video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
  .feature-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--spacing-md);
  }
  .feature-item {
    padding: var(--spacing-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .feature-item h3 {
    margin: 0 0 0.5rem;
    color: var(--color-primary-dark);
  }
  .restaurant-detail__features {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: var(--spacing-xs) 0;
  }
  .restaurant-detail__features li {
    background: var(--color-accent);
    color: var(--color-text);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.85rem;
  }
  .restaurant-detail__hours {
    list-style: none;
    padding: 0;
    color: var(--color-text-muted);
  }
  .menu-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
    background: var(--color-surface);
  }
  .menu-card__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .menu-card__price--before {
    text-decoration: line-through;
    color: var(--color-text-muted);
    margin-right: 0.5rem;
  }
  .menu-card__price--current {
    font-weight: 700;
    color: var(--color-primary);
  }
  .menu-card__category h4 {
    text-transform: capitalize;
    margin: var(--spacing-xs) 0 0.25rem;
    color: var(--color-primary-dark);
  }
  .menu-card__category ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  .restaurant-detail__reviews {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
  }
  .restaurant-detail__related h2 {
    color: var(--color-primary-dark);
  }
  .restaurant-detail__related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--spacing-md);
  }
  @media (max-width: 720px) {
    .restaurant-detail__grid,
    .restaurant-detail__reviews {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab-trigger]'));
  const tabPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-tab-panel]'));

  function activateTab(name: string) {
    tabButtons.forEach((button) => {
      const isActive = button.dataset.tabTrigger === name;
      button.setAttribute('aria-selected', String(isActive));
      button.tabIndex = isActive ? 0 : -1;
    });
    tabPanels.forEach((panel) => {
      panel.hidden = panel.dataset.tabPanel !== name;
    });
  }

  tabButtons.forEach((button, index) => {
    button.addEventListener('click', () => activateTab(button.dataset.tabTrigger ?? ''));
    button.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      const nextIndex = event.key === 'ArrowLeft'
        ? (index - 1 + tabButtons.length) % tabButtons.length
        : (index + 1) % tabButtons.length;
      tabButtons[nextIndex].focus();
      activateTab(tabButtons[nextIndex].dataset.tabTrigger ?? '');
    });
  });
</script>
