---
import Layout from '../../layouts/Layout.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import ReviewForm from '../../components/ReviewForm.astro';
import ReviewList from '../../components/ReviewList.astro';
import { getAllRestaurants, getReviews } from '../../lib/data';
import type { Restaurant } from '../../types';

export async function getStaticPaths() {
  const restaurants = await getAllRestaurants();
  return restaurants.map((restaurant) => ({
    params: { slug: restaurant.slug },
    props: { restaurant },
  }));
}

interface Props {
  restaurant: Restaurant;
}

const { restaurant } = Astro.props;
const reviews = await getReviews(restaurant.slug);

const dayLabels: Record<string, string> = {
  lunes: 'Lunes',
  martes: 'Martes',
  miercoles: 'Miércoles',
  jueves: 'Jueves',
  viernes: 'Viernes',
  sabado: 'Sábado',
  domingo: 'Domingo',
};

const menuCategories = ['entrantes', 'fuerte', 'postre'] as const;
---

<Layout title={restaurant.name}>
  <article class="restaurant-detail">
    <header class="restaurant-detail__header">
      <h1>{restaurant.name}</h1>
      <p class="restaurant-detail__meta">{restaurant.cuisineTypes.join(', ')} · {restaurant.zone}</p>
    </header>

    <PhotoGallery photos={restaurant.gallery} alt={restaurant.name} />

    <div class="restaurant-detail__grid">
      <section class="restaurant-detail__info">
        <h2>Información</h2>
        <p>{restaurant.address}</p>
        <p><a href={`tel:${restaurant.phone}`}>{restaurant.phone}</a></p>
        {restaurant.whatsapp && (
          <p><a href={`https://wa.me/${restaurant.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a></p>
        )}
        {restaurant.instagram && (
          <p>
            <a href={`https://instagram.com/${restaurant.instagram}`} target="_blank" rel="noopener">
              @{restaurant.instagram}
            </a>
          </p>
        )}

        <ul class="restaurant-detail__features">
          {restaurant.features.petFriendly && <li>Pet friendly</li>}
          {restaurant.features.delivery && <li>Delivery</li>}
          {restaurant.features.tableService && <li>Servicio a la mesa</li>}
          {restaurant.features.paymentMethods.length > 0 && (
            <li>Medios de pago: {restaurant.features.paymentMethods.join(', ')}</li>
          )}
        </ul>

        <h2>Horarios</h2>
        <ul class="restaurant-detail__hours">
          {restaurant.hours.map((h) => (
            <li>{dayLabels[h.day] ?? h.day}: {h.opens} – {h.closes}</li>
          ))}
        </ul>
      </section>

      <section class="restaurant-detail__menus">
        <h2>Menús</h2>
        {restaurant.menus.map((menu) => (
          <div class="menu-card">
            <div class="menu-card__header">
              <h3>{menu.name}</h3>
              <div class="menu-card__price">
                {menu.previousPrice && (
                  <span class="menu-card__price--before">${menu.previousPrice.toLocaleString('es-CO')}</span>
                )}
                <span class="menu-card__price--current">${menu.currentPrice.toLocaleString('es-CO')}</span>
              </div>
            </div>
            {menuCategories.map((category) => {
              const items = menu.items.filter((item) => item.category === category);
              if (items.length === 0) return null;
              return (
                <div class="menu-card__category">
                  <h4>{category}</h4>
                  <ul>
                    {items.map((item) => (
                      <li>
                        {item.name}
                        {item.description && <span> — {item.description}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
              );
            })}
          </div>
        ))}
      </section>
    </div>

    <section class="restaurant-detail__reviews">
      <ReviewList restaurantSlug={restaurant.slug} reviews={reviews} />
      <ReviewForm restaurantSlug={restaurant.slug} />
    </section>
  </article>
</Layout>

<style>
  .restaurant-detail {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--spacing-lg) var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }
  .restaurant-detail__header h1 {
    color: var(--color-primary-dark);
    margin-bottom: 0.25rem;
  }
  .restaurant-detail__meta {
    color: var(--color-text-muted);
  }
  .restaurant-detail__grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--spacing-lg);
  }
  .restaurant-detail__features {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: var(--spacing-xs) 0;
  }
  .restaurant-detail__features li {
    background: var(--color-accent);
    color: var(--color-text);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.85rem;
  }
  .restaurant-detail__hours {
    list-style: none;
    padding: 0;
    color: var(--color-text-muted);
  }
  .menu-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
    background: var(--color-surface);
  }
  .menu-card__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .menu-card__price--before {
    text-decoration: line-through;
    color: var(--color-text-muted);
    margin-right: 0.5rem;
  }
  .menu-card__price--current {
    font-weight: 700;
    color: var(--color-primary);
  }
  .menu-card__category h4 {
    text-transform: capitalize;
    margin: var(--spacing-xs) 0 0.25rem;
    color: var(--color-primary-dark);
  }
  .menu-card__category ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  .restaurant-detail__reviews {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
  }
  @media (max-width: 720px) {
    .restaurant-detail__grid,
    .restaurant-detail__reviews {
      grid-template-columns: 1fr;
    }
  }
</style>
