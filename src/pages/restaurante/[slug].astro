---
import Layout from '../../layouts/Layout.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import ReviewForm from '../../components/ReviewForm.astro';
import ReviewList from '../../components/ReviewList.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import WeeklyRecommended from '../../components/WeeklyRecommended.astro';
import { getAllRestaurants, getReviews, getWeeklyRecommendedRestaurants } from '../../lib/data';
import type { Restaurant } from '../../types';

export async function getStaticPaths() {
  const restaurants = await getAllRestaurants();
  return restaurants.map((restaurant) => ({
    params: { slug: restaurant.slug },
    props: { restaurant },
  }));
}

interface Props {
  restaurant: Restaurant;
}

const { restaurant } = Astro.props;
const reviews = await getReviews(restaurant.slug);
const weeklyRecommended = await getWeeklyRecommendedRestaurants(restaurant.slug);

const menuCategories = ['entrantes', 'fuerte', 'postre'] as const;

function whatsappLink(value: string): string {
  return value.startsWith('http') ? value : `https://wa.me/${value}`;
}

function youtubeEmbedUrl(url?: string): string | null {
  if (!url) return null;
  try {
    const parsed = new URL(url);
    if (parsed.hostname.includes('youtu.be')) {
      return `https://www.youtube.com/embed${parsed.pathname}`;
    }
    const videoId = parsed.searchParams.get('v');
    if (videoId) return `https://www.youtube.com/embed/${videoId}`;
    if (parsed.pathname.startsWith('/embed/')) return url;
    return null;
  } catch {
    return null;
  }
}

const videoEmbedUrl = youtubeEmbedUrl(restaurant.youtubeVideoUrl);
---

<Layout title={restaurant.name}>
  <PhotoGallery photos={restaurant.gallery} alt={restaurant.name} />

  <article class="restaurant-detail">
    <header class="restaurant-detail__header">
      <h1>{restaurant.name}</h1>
      <p class="restaurant-detail__meta">{restaurant.cuisineTypes.join(', ')} · {restaurant.zone}</p>
    </header>

    <div class="restaurant-detail__tabs" role="tablist" aria-label="Secciones del restaurante">
      <button
        type="button"
        class="restaurant-detail__tab"
        role="tab"
        id="tab-info"
        aria-controls="panel-info"
        aria-selected="true"
        data-tab-trigger="info"
      >
        Información
      </button>
      <button
        type="button"
        class="restaurant-detail__tab"
        role="tab"
        id="tab-valoraciones"
        aria-controls="panel-valoraciones"
        aria-selected="false"
        tabindex="-1"
        data-tab-trigger="valoraciones"
      >
        Valoraciones ({reviews.length})
      </button>
    </div>

    <div id="panel-info" role="tabpanel" aria-labelledby="tab-info" data-tab-panel="info">
      <div class="restaurant-detail__grid">
        <section class="restaurant-detail__menus">
          <div class="menu-card">
            <h2 class="section-heading">
              <svg class="section-heading__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 2v7a3 3 0 0 0 3 3v10"></path>
                <path d="M6 2v20"></path>
                <path d="M10 2v20"></path>
                <path d="M18 2c-2 1-3 3-3 6s1 5 3 6v8"></path>
              </svg>
              Menús
            </h2>
            {restaurant.menus.map((menu) => (
              <div class="menu-card__menu">
                <div class="menu-card__header">
                  <h3>{menu.name}</h3>
                </div>
                <p class="menu-card__price">
                  {menu.previousPrice && (
                    <span class="menu-card__price--before">${menu.previousPrice.toLocaleString('es-CO')}</span>
                  )}
                  <span class="menu-card__price--current">${menu.currentPrice.toLocaleString('es-CO')}</span>
                </p>
                {menuCategories.map((category) => {
                  const items = menu.items.filter((item) => item.category === category);
                  if (items.length === 0) return null;
                  return (
                    <div class="menu-card__category">
                      <h4>{category}</h4>
                      <ul>
                        {items.map((item) => (
                          <li>
                            {item.name}
                            {item.description && <span> — {item.description}</span>}
                          </li>
                        ))}
                      </ul>
                    </div>
                  );
                })}
              </div>
            ))}

            {restaurant.menuHighlights.length > 0 && (
              <ul class="restaurant-detail__menu-highlights">
                {restaurant.menuHighlights.map((highlight) => (
                  <li>
                    <img src={highlight.icon} alt="" />
                    <span>{highlight.label}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <div class="info-card">
            <h2 class="section-heading">
              <svg class="section-heading__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
              Información general
            </h2>
            <p class="info-card__label">Dirección</p>
            <p>{restaurant.address}</p>
            <p><a href={`tel:${restaurant.phone}`}>{restaurant.phone}</a></p>

            <p class="info-card__label">Horario de atención</p>
            <p class="restaurant-detail__hours">{restaurant.hours}</p>
          </div>
        </section>

        <aside class="restaurant-detail__sidebar">
        <div class="feature-item">
          <h3 class="section-heading">
            <svg class="section-heading__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" y1="21" x2="20" y2="21"></line>
              <line x1="4" y1="10" x2="20" y2="10"></line>
              <line x1="4" y1="4" x2="20" y2="4"></line>
            </svg>
            Características
          </h3>
          <ul class="feature-badges">
            {restaurant.features.parking && (
              <li><span class="feature-badge feature-badge--text" aria-hidden="true">P</span>Parqueadero</li>
            )}
            {restaurant.features.petFriendly && (
              <li>
                <span class="feature-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                    <circle cx="7" cy="9" r="2"></circle>
                    <circle cx="12" cy="6.5" r="2"></circle>
                    <circle cx="17" cy="9" r="2"></circle>
                    <path d="M12 12.5c-2.5 0-5 1.6-5 4a2.5 2.5 0 0 0 4 2c.4-.5.6-1 1-1s.6.5 1 1a2.5 2.5 0 0 0 4-2c0-2.4-2.5-4-5-4z"></path>
                  </svg>
                </span>
                Pet friendly
              </li>
            )}
            {restaurant.features.delivery && (
              <li>
                <span class="feature-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 8l-9-5-9 5 9 5 9-5z"></path>
                    <path d="M3 8v8l9 5 9-5V8"></path>
                    <path d="M12 13v8"></path>
                  </svg>
                </span>
                Delivery
              </li>
            )}
            {restaurant.features.tableService && (
              <li>
                <span class="feature-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                  </svg>
                </span>
                Servicio a la mesa
              </li>
            )}
            {restaurant.features.creditCard && (
              <li>
                <span class="feature-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                    <line x1="2" y1="10" x2="22" y2="10"></line>
                  </svg>
                </span>
                Tarjeta de crédito
              </li>
            )}
          </ul>
        </div>

        <div class="feature-item">
          <h3 class="section-heading">
            <svg class="section-heading__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.6" y1="10.6" x2="15.4" y2="6.4"></line>
              <line x1="8.6" y1="13.4" x2="15.4" y2="17.6"></line>
            </svg>
            Contacto
          </h3>
          <ul class="feature-badges">
            {restaurant.whatsapp && (
              <li>
                <a href={whatsappLink(restaurant.whatsapp)} target="_blank" rel="noopener">
                  <span class="feature-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    </svg>
                  </span>
                  WhatsApp
                </a>
              </li>
            )}
            {restaurant.instagram && (
              <li>
                <a href={`https://instagram.com/${restaurant.instagram}`} target="_blank" rel="noopener">
                  <span class="feature-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                      <circle cx="12" cy="13" r="4"></circle>
                    </svg>
                  </span>
                  @{restaurant.instagram}
                </a>
              </li>
            )}
          </ul>
          <ShareButtons title={restaurant.name} />
        </div>

        {restaurant.vegetarianOption && (
          <div class="feature-item">
            <h3 class="section-heading">
              <svg class="section-heading__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2C8 6 6 9 6 13a6 6 0 0 0 12 0c0-4-2-7-6-11z"></path>
              </svg>
              Opciones alimenticias
            </h3>
            <ul class="feature-badges">
              <li>
                <span class="feature-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 2C8 6 6 9 6 13a6 6 0 0 0 12 0c0-4-2-7-6-11z"></path>
                  </svg>
                </span>
                Opción vegetariana
              </li>
            </ul>
          </div>
        )}

        <div class="feature-item">
          <h3 class="section-heading">
            <svg class="section-heading__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 2v7a3 3 0 0 0 3 3v10"></path>
              <path d="M6 2v20"></path>
              <path d="M10 2v20"></path>
              <path d="M18 2c-2 1-3 3-3 6s1 5 3 6v8"></path>
            </svg>
            Tipos de cocina
          </h3>
          <ul class="feature-badges">
            {restaurant.cuisineTypes.map((type) => (
              <li>
                <span class="feature-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 2v7a3 3 0 0 0 3 3v10"></path>
                    <path d="M6 2v20"></path>
                    <path d="M10 2v20"></path>
                    <path d="M18 2c-2 1-3 3-3 6s1 5 3 6v8"></path>
                  </svg>
                </span>
                {type}
              </li>
            ))}
          </ul>
        </div>
        </aside>
      </div>

      {videoEmbedUrl && (
        <section class="restaurant-detail__video">
          <div class="restaurant-detail__video-frame">
            <iframe
              src={videoEmbedUrl}
              title={`Video de ${restaurant.name}`}
              loading="lazy"
              allowfullscreen
            ></iframe>
          </div>
        </section>
      )}
    </div>

    <section
      class="restaurant-detail__reviews"
      id="panel-valoraciones"
      role="tabpanel"
      aria-labelledby="tab-valoraciones"
      data-tab-panel="valoraciones"
      hidden
    >
      <ReviewList restaurantSlug={restaurant.slug} reviews={reviews} />
      <ReviewForm restaurantSlug={restaurant.slug} />
    </section>

  </article>

  <WeeklyRecommended restaurants={weeklyRecommended} />
</Layout>

<style>
  .restaurant-detail {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--spacing-lg) var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }
  .restaurant-detail__header h1 {
    color: var(--color-primary-dark);
    margin-bottom: 0.25rem;
  }
  .restaurant-detail__meta {
    color: var(--color-text-muted);
  }
  .restaurant-detail__tabs {
    display: flex;
    gap: var(--spacing-sm);
    border-bottom: 1px solid var(--color-border);
  }
  .restaurant-detail__tab {
    padding: 0.75rem 1rem;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    font: inherit;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .restaurant-detail__tab:hover {
    color: var(--color-primary-dark);
  }
  .restaurant-detail__tab[aria-selected='true'] {
    color: var(--color-primary-dark);
    border-bottom-color: var(--color-primary);
  }
  [data-tab-panel][hidden] {
    display: none;
  }
  .restaurant-detail__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--spacing-lg);
  }
  .restaurant-detail__menus {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  .restaurant-detail__sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  .section-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 var(--spacing-sm);
  }
  .section-heading__icon {
    flex-shrink: 0;
    color: var(--color-primary);
  }
  .restaurant-detail__menu-highlights {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin: var(--spacing-sm) 0;
  }
  .restaurant-detail__menu-highlights li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
  }
  .restaurant-detail__menu-highlights img {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
  }
  .info-card {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: var(--spacing-md);
    box-shadow: 0 1px 3px rgba(43, 33, 24, 0.08), 0 4px 12px rgba(43, 33, 24, 0.06);
  }
  .info-card__label {
    margin: var(--spacing-sm) 0 0.15rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .info-card__label:first-of-type {
    margin-top: 0;
  }
  .restaurant-detail__video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .restaurant-detail__video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
  .feature-item {
    padding: var(--spacing-md);
    background: var(--color-surface);
    border-radius: var(--radius);
    box-shadow: 0 1px 3px rgba(43, 33, 24, 0.08), 0 4px 12px rgba(43, 33, 24, 0.06);
  }
  .feature-badges {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .feature-badges li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
  }
  .feature-badges a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text);
    text-decoration: none;
  }
  .feature-badges a:hover {
    color: var(--color-primary-dark);
  }
  .feature-badge {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
  }
  .feature-badge--text {
    font-size: 0.75rem;
    font-weight: 700;
  }
  .restaurant-detail__hours {
    color: var(--color-text-muted);
    white-space: pre-line;
  }
  .menu-card {
    border-radius: var(--radius);
    padding: var(--spacing-md);
    background: var(--color-surface);
    box-shadow: 0 1px 3px rgba(43, 33, 24, 0.08), 0 4px 12px rgba(43, 33, 24, 0.06);
  }
  .menu-card__menu {
    margin-top: var(--spacing-md);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border);
  }
  .menu-card__menu:first-of-type {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .menu-card__header h3 {
    margin: 0;
  }
  .menu-card__price {
    margin: 0.25rem 0 0;
    font-size: 1.2rem;
  }
  .menu-card__price--before {
    text-decoration: line-through;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-right: 0.5rem;
  }
  .menu-card__price--current {
    font-weight: 700;
    color: var(--color-primary);
  }
  .menu-card__category h4 {
    text-transform: capitalize;
    margin: var(--spacing-xs) 0 0.25rem;
    color: var(--color-primary-dark);
  }
  .menu-card__category ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  .restaurant-detail__reviews {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
  }
  @media (max-width: 720px) {
    .restaurant-detail__grid,
    .restaurant-detail__reviews {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab-trigger]'));
  const tabPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-tab-panel]'));

  function activateTab(name: string) {
    tabButtons.forEach((button) => {
      const isActive = button.dataset.tabTrigger === name;
      button.setAttribute('aria-selected', String(isActive));
      button.tabIndex = isActive ? 0 : -1;
    });
    tabPanels.forEach((panel) => {
      panel.hidden = panel.dataset.tabPanel !== name;
    });
  }

  tabButtons.forEach((button, index) => {
    button.addEventListener('click', () => activateTab(button.dataset.tabTrigger ?? ''));
    button.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      const nextIndex = event.key === 'ArrowLeft'
        ? (index - 1 + tabButtons.length) % tabButtons.length
        : (index + 1) % tabButtons.length;
      tabButtons[nextIndex].focus();
      activateTab(tabButtons[nextIndex].dataset.tabTrigger ?? '');
    });
  });
</script>
